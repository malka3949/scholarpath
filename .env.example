# PostgreSQL — הגדרה ב-.env

# =============================================================================
# שלב 1: מלא את הסיסמה של משתמש postgres (superuser)
# =============================================================================
# זו הסיסמה שהגדרת בהתקנת PostgreSQL 17 על Windows.
# בלי זה — npm run db:setup לא יעבוד.

POSTGRES_SUPERUSER_PASSWORD=

# =============================================================================
# שלב 2: כתובת DB (לא לשנות אחרי db:setup)
# =============================================================================

DATABASE_URL="postgresql://scholarpath:scholarpath@localhost:5432/scholarpath?schema=public"

# =============================================================================
# Auth & App (נשאר כמו שהיה)
# =============================================================================

JWT_SECRET="dev-secret-change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="dev-nextauth-secret-change-me"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_API_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3000"

# Phase 2 — Claude API (optional; without it, rule-based ranking is used)
ANTHROPIC_API_KEY=""

# Phase 6 — Email delivery (default off in dev)
MAIL_ENABLED=false
MAIL_PROVIDER=log
EMAIL_FROM="notifications@scholarpath.local"
# Per-user delivery (dev): Gmail SMTP — App Password required (not regular password)
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# Production: Resend + verified domain (emails any user at user.email)
# MAIL_PROVIDER=resend
# RESEND_API_KEY=""
# EMAIL_FROM=notifications@yourdomain.com
MAIL_OVERRIDE_TO=""
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
# Optional cron override (default: daily 07:00 UTC)
CRON_DEADLINE_SYNC=""
CRON_ACTION_RECONCILE=""
ACTION_WEIGHT_URGENCY=0.4
ACTION_WEIGHT_IMPACT=0.3
ACTION_WEIGHT_COMPLETION_GAP=0.2
ACTION_WEIGHT_ENGAGEMENT=0.1
